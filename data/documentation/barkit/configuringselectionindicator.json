{"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The selection indicator is a rounded rectangle that moves between items when selection changes."},{"type":"text","text":" "},{"type":"text","text":"It is configured via "},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/SelectionIndicatorConfiguration","isActive":true,"type":"reference"},{"type":"text","text":", passed to "},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarConfiguration\/indicator","isActive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Pass "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to disable the indicator entirely."}],"type":"paragraph"},{"anchor":"Color-and-border","text":"Color and border","level":2,"type":"heading"},{"syntax":"swift","code":[".init(","    indicator: .init(","        color: .white.opacity(0.2),","        border: .init(color: .white.opacity(0.4), lineWidth: 1)","    )",")"],"type":"codeListing"},{"anchor":"Insets","text":"Insets","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Control the gap between the indicator and the item frame:"}],"type":"paragraph"},{"syntax":"swift","code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Positive values shrink the indicator, negative values expand it beyond the item bounds."}],"type":"paragraph"},{"anchor":"Transition-animation","text":"Transition animation","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The indicator moves between items with a configurable animation:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"],"type":"codeListing"},{"anchor":"Scale-effect","level":2,"type":"heading","text":"Scale effect"},{"inlineContent":[{"type":"text","text":"Apply a brief scale pulse to the indicator during transition:"}],"type":"paragraph"},{"type":"codeListing","code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"],"syntax":"swift"},{"anchor":"Drag-gesture","level":2,"type":"heading","text":"Drag gesture"},{"inlineContent":[{"text":"By default the user can drag the indicator between items. Disable if needed:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":[".init(indicator: .init(isDragGestureEnabled: false))"],"syntax":"swift"},{"anchor":"Metal-shader-effects","level":2,"type":"heading","text":"Metal shader effects"},{"inlineContent":[{"type":"text","text":"Visual effects applied at the indicator boundary, inspired by lens distortion and chromatic aberration."}],"type":"paragraph"},{"anchor":"Lens-distortion","level":3,"type":"heading","text":"Lens distortion"},{"inlineContent":[{"text":"Displaces pixels near the indicator edge, creating a subtle warping effect.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"type":"text","text":" — width of the distortion zone in points (typical range 2.0–12.0)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"strength"},{"text":" — maximum pixel displacement (typical range 1.5–5.0)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":[".init(indicator: .init(effects: [.lensDistortion(.init(zoneWidth: 12, strength: 2))]))"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","text":"Chromatic aberration","anchor":"Chromatic-aberration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Separates RGB channels near the indicator edge, creating a color fringe effect."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"type":"text","text":" — width of the aberration zone in points (typical range 1.0–6.0)"}]}]},{"content":[{"inlineContent":[{"code":"strength","type":"codeVoice"},{"text":" — RGB channel separation in pixels (typical range 1.0–4.0)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":[".init(indicator: .init(effects: [.chromaticAberration(.init(zoneWidth: 8, strength: 4))]))"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Both effects can be combined:","type":"text"}]},{"code":[".init(indicator: .init(effects: [.lensDistortion(), .chromaticAberration()]))"],"syntax":"swift","type":"codeListing"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Both effects are inspired by their physical counterparts and do not attempt to model them accurately."}]}],"type":"aside","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All Selection indicator configuration options are available interactively in the Example App under the "},{"inlineContent":[{"type":"text","text":"Selection indicator"}],"type":"strong"},{"type":"text","text":" settings section."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Article","modules":[{"name":"BarKit"}],"role":"article","title":"Configuring the Selection Indicator"},"identifier":{"url":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringSelectionIndicator","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/barkit.BarKit\/documentation\/BarKit\/GettingStarted","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringLayout","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringBackground","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringItems","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringAnimations","doc:\/\/barkit.BarKit\/documentation\/BarKit\/TabBarIntegration","doc:\/\/barkit.BarKit\/documentation\/BarKit\/AdditionalConfiguration","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringBadges"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/barkit\/configuringselectionindicator"]}],"abstract":[{"type":"text","text":"Customize the animated highlight that tracks the selected item."}],"kind":"article","hierarchy":{"paths":[["doc:\/\/barkit.BarKit\/documentation\/BarKit"]]},"sections":[],"references":{"doc://barkit.BarKit/documentation/BarKit/SelectionIndicatorConfiguration":{"abstract":[{"text":"Defines the visual appearance and behavior of the selection indicator.","type":"text"}],"title":"SelectionIndicatorConfiguration","navigatorTitle":[{"kind":"identifier","text":"SelectionIndicatorConfiguration"}],"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/SelectionIndicatorConfiguration","role":"symbol","type":"topic","url":"\/documentation\/barkit\/selectionindicatorconfiguration","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SelectionIndicatorConfiguration"}],"kind":"symbol"},"doc://barkit.BarKit/documentation/BarKit/ConfiguringBadges":{"type":"topic","url":"\/documentation\/barkit\/configuringbadges","title":"Configuring Badges","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringBadges","abstract":[{"type":"text","text":"Display badge overlays on bar items to communicate status or counts."}],"role":"article","kind":"article"},"doc://barkit.BarKit/documentation/BarKit/ConfiguringAnimations":{"kind":"article","url":"\/documentation\/barkit\/configuringanimations","title":"Configuring Animations","role":"article","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringAnimations","type":"topic","abstract":[]},"doc://barkit.BarKit/documentation/BarKit/GettingStarted":{"kind":"article","url":"\/documentatio