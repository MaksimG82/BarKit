s","anchor":"Insets"},{"type":"paragraph","inlineContent":[{"text":"Control the gap between the indicator and the item frame:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"]},{"type":"paragraph","inlineContent":[{"text":"Positive values shrink the indicator, negative values expand it beyond the item bounds.","type":"text"}]},{"type":"heading","level":2,"text":"Transition animation","anchor":"Transition-animation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The indicator moves between items with a configurable animation:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"]},{"type":"heading","level":2,"text":"Scale effect","anchor":"Scale-effect"},{"type":"paragraph","inlineContent":[{"text":"Apply a brief scale pulse to the indicator during transition:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"]},{"type":"heading","level":2,"text":"Drag gesture","anchor":"Drag-gesture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default the user can drag the indicator between items. Disable if needed:"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(isDragGestureEnabled: false))"]},{"type":"heading","level":2,"text":"Metal shader effects","anchor":"Metal-shader-effects"},{"type":"paragraph","inlineContent":[{"text":"Visual effects applied at the indicator boundary, inspired by lens distortion and chromatic aberration.","type":"text"}]},{"type":"heading","level":3,"text":"Lens distortion","anchor":"Lens-distortion"},{"type":"paragraph","inlineContent":[{"text":"Displaces pixels near the indicator edge, creating a subtle warping effect.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"zoneWidth","type":"codeVoice"},{"type":"text","text":" — width of the distortion zone in points (typical range 2.0–12.0)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"strength"},{"type":"text","text":" — maximum pixel displacement (typical range 1.5–5.0)"}]}]}]},{"syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(.init(zoneWidth: 12, strength: 2))]))"],"type":"codeListing"},{"text":"Chromatic aberration","anchor":"Chromatic-aberration","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Separates RGB channels near the indicator edge, creating a color fringe effect.","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"type":"text","text":" — width of the aberration zone in points (typical range 1.0–6.0)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"strength","type":"codeVoice"},{"text":" — RGB channel separation in pixels (typical range 1.0–4.0)","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":[".init(indicator: .init(effects: [.chromaticAberration(.init(zoneWidth: 8, strength: 4))]))"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both effects can be combined:"}]},{"syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(), .chromaticAberration()]))"],"type":"codeListing"},{"style":"note","name":"Note","content":[{"inlineContent":[{"text":"Both effects are inspired by their physical counterparts and do not attempt to model them accurately.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"All Selection indicator configuration options are available interactively 