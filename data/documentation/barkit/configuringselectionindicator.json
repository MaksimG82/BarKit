{"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/barkit\/configuringselectionindicator"]}],"hierarchy":{"paths":[["doc:\/\/barkit.BarKit\/documentation\/BarKit"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The selection indicator is a rounded rectangle that moves between items when selection changes."},{"type":"text","text":" "},{"type":"text","text":"It is configured via "},{"type":"reference","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/SelectionIndicatorConfiguration","isActive":true},{"type":"text","text":", passed to "},{"type":"reference","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarConfiguration\/indicator","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to disable the indicator entirely."}]},{"type":"heading","text":"Color and border","anchor":"Color-and-border","level":2},{"type":"codeListing","syntax":"swift","code":[".init(","    indicator: .init(","        color: .white.opacity(0.2),","        border: .init(color: .white.opacity(0.4), lineWidth: 1)","    )",")"]},{"type":"heading","text":"Insets","anchor":"Insets","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Control the gap between the indicator and the item frame:"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"]},{"type":"paragraph","inlineContent":[{"text":"Positive values shrink the indicator, negative values expand it beyond the item bounds.","type":"text"}]},{"type":"heading","text":"Transition animation","anchor":"Transition-animation","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The indicator moves between items with a configurable animation:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"]},{"type":"heading","text":"Scale effect","anchor":"Scale-effect","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply a brief scale pulse to the indicator during transition:"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"]},{"type":"heading","text":"Drag gesture","anchor":"Drag-gesture","level":2},{"type":"paragraph","inlineContent":[{"text":"By default the user can drag the indicator between items. Disable if needed:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(isDragGestureEnabled: false))"]},{"type":"heading","text":"Metal shader effects","anchor":"Metal-shader-effects","level":2},{"type":"paragraph","inlineContent":[{"text":"Visual effects applied at the indicator boundary, inspired by lens distortion and chromatic aberration.","type":"text"}]},{"type":"heading","text":"Lens distortion","anchor":"Lens-distortion","level":3},{"type":"paragraph","inlineContent":[{"text":"Displaces pixels near the indicator edge, creating a subtle warping effect.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"type":"text","text":" — width of the distortion zone in points (typical range 2.0–12.0)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"strength"},{"type":"text","text":" — maximum pixel displacement (typical range 1.5–5.0)"}]}]}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(.init(zoneWidth: 12, strength: 2))]))"]},{"type":"heading","text":"Chromatic aberration","anchor":"Chromatic-aberration","level":3},{"type":"paragraph","inlineContent":[{"text":"Separates RGB channels near the indicator edge, creating a color fringe effect.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"type":"text","text":" — width of the aberration zone in points (typical range 1.0–6.0)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"strength","type":"codeVoice"},{"type":"text","text":" — RGB channel separation in pixels (typical range 1.0–4.0)"}]}]}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(effects: [.chromaticAberration(.init(zoneWidth: 8, strength: 4))]))"]},{"type":"paragraph","inlineContent":[{"text":"Both effects can be combined:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(), .chromaticAberration()]))"]},{"type":"aside","content":[{"inlineContent":[{"text":"Both effects are inspired by their physical counterparts and do not attempt to model them accurately.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All Selection indicator configuration options are available interactively in the Example App under the "},{"type":"strong","inlineContent":[{"type":"text","text":"Selection indicator"}]},{"type":"text","text":" settings section."}]}]}],"sections":[],"abstract":[{"text":"Customize the animated highlight that tracks the selected item.","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/barkit.BarKit\/documentation\/BarKit\/GettingStarted","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringLayout","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringBackground","doc:\/\/barkit.BarKit\/documentation\/BarK