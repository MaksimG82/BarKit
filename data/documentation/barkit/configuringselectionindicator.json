{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The selection indicator is a rounded rectangle that moves between items when selection changes."},{"type":"text","text":" "},{"type":"text","text":"It is configured via "},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/SelectionIndicatorConfiguration","type":"reference","isActive":true},{"type":"text","text":", passed to "},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarConfiguration\/indicator","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to disable the indicator entirely."}],"type":"paragraph"},{"anchor":"Color-and-border","level":2,"type":"heading","text":"Color and border"},{"syntax":"swift","code":[".init(","    indicator: .init(","        color: .white.opacity(0.2),","        border: .init(color: .white.opacity(0.4), lineWidth: 1)","    )",")"],"type":"codeListing"},{"anchor":"Insets","level":2,"type":"heading","text":"Insets"},{"inlineContent":[{"text":"Control the gap between the indicator and the item frame:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"],"type":"codeListing"},{"inlineContent":[{"text":"Positive values shrink the indicator, negative values expand it beyond the item bounds.","type":"text"}],"type":"paragraph"},{"anchor":"Transition-animation","level":2,"type":"heading","text":"Transition animation"},{"inlineContent":[{"type":"text","text":"The indicator moves between items with a configurable animation:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"],"type":"codeListing"},{"text":"Scale effect","level":2,"anchor":"Scale-effect","type":"heading"},{"inlineContent":[{"type":"text","text":"Apply a brief scale pulse to the indicator during transition:"}],"type":"paragraph"},{"code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"],"syntax":"swift","type":"codeListing"},{"text":"Drag gesture","level":2,"anchor":"Drag-gesture","type":"heading"},{"inlineContent":[{"text":"By default the user can drag the indicator between items. Disable if needed:","type":"text"}],"type":"paragraph"},{"code":[".init(indicator: .init(isDragGestureEnabled: false))"],"syntax":"swift","type":"codeListing"},{"text":"Metal shader effects","level":2,"anchor":"Metal-shader-effects","type":"heading"},{"inlineContent":[{"text":"Visual effects applied at the indicator boundary, inspired by lens distortion and chromatic aberration.","type":"text"}],"type":"paragraph"},{"text":"Lens distortion","level":3,"anchor":"Lens-distortion","type":"heading"},{"inlineContent":[{"text":"Displaces pixels near the indicator edge, creating a subtle warping effect.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"zoneWidth","type":"codeVoice"},{"text":" — width of the distortion zone in points (typical range 2.0–12.0)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"strength","type":"codeVoice"},{"text":" — maximum pixel displacement (typical range 1.5–5.0)","type":"text"}]}]}],"type":"unorderedList"},{"code":[".init(indicator: .init(effects: [.lensDistortion(.init(zoneWidth: 12, strength: 2))]))"],"syntax":"swift","type":"codeListing"},{"text":"Chromatic aberration","level":3,"anchor":"Chromatic-aberration","type":"heading"},{"inlineContent":[{"type":"text","text":"Separates RGB channels near the indicator edge, creating a color fringe effect."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"zoneWidth","type":"codeVoice"},{"type":"text","text":" — width of the aberration zone in points (typical range 1.0–6.0)"}]}]},{"content":[{"inlineContent":[{"code":"strength","type":"codeVoice"},{"type":"text","text":" — RGB channel separation in pixels (typical range 1.0–4.0)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":[".init(indicator: .init(effects: [.chromaticAberration(.init(zoneWidth: 8, strength: 4))]))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Both effects can be combined:","type":"text"}],"type":"paragraph"},{"code":[".init(indicator: .init(effects: [.lensDistortion(), .chromaticAberration()]))"],"syntax":"swift","type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Both effects are inspired by their physical counterparts and do not attempt to model them accurately."}]}],"name":"Note","style":"note","type":"aside"},{"inlineContent":[{"type":"text","text":"All Selection indicator configuration options are available interactively in the Example App under the "},{"inlineContent":[{"type":"text","text":"Selection indicator"}],"type":"strong"},{"type":"text","text":" settings section."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Article","role":"article","title":"Configuring the Selection Indicator","modules":[{"name":"BarKit"}]},"kind":"article","identifier":{"url":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringSelectionIndicator","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Customize the animated highlight that tracks the selected item."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/barkit.BarKit\/documentation\/BarKit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/barkit.BarKit\/documentation\/BarKit\/GettingStarted","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringLayo