{"kind":"article","primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The selection indicator is a rounded rectangle that moves between items when selection changes."},{"type":"text","text":" "},{"type":"text","text":"It is configured via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/SelectionIndicatorConfiguration"},{"type":"text","text":", passed to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarConfiguration\/indicator"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to disable the indicator entirely."}]},{"type":"heading","anchor":"Color-and-border","text":"Color and border","level":2},{"type":"codeListing","syntax":"swift","code":[".init(","    indicator: .init(","        color: .white.opacity(0.2),","        border: .init(color: .white.opacity(0.4), lineWidth: 1)","    )",")"]},{"type":"heading","anchor":"Insets","text":"Insets","level":2},{"type":"paragraph","inlineContent":[{"text":"Control the gap between the indicator and the item frame:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Positive values shrink the indicator, negative values expand it beyond the item bounds."}]},{"type":"heading","anchor":"Transition-animation","text":"Transition animation","level":2},{"type":"paragraph","inlineContent":[{"text":"The indicator moves between items with a configurable animation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"]},{"type":"heading","anchor":"Scale-effect","text":"Scale effect","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply a brief scale pulse to the indicator during transition:"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"]},{"type":"heading","anchor":"Drag-gesture","text":"Drag gesture","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default the user can drag the indicator between items. Disable if needed:"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(isDragGestureEnabled: false))"]},{"type":"heading","anchor":"Metal-shader-effects","text":"Metal shader effects","level":2},{"type":"paragraph","inlineContent":[{"text":"Visual effects applied at the indicator boundary, inspired by lens distortion and chromatic aberration.","type":"text"}]},{"type":"heading","anchor":"Lens-distortion","text":"Lens distortion","level":3},{"type":"paragraph","inlineContent":[{"text":"Displaces pixels near the indicator edge, creating a subtle warping effect.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"zoneWidth","type":"codeVoice"},{"text":" — width of the distortion zone in points (typical range 2.0–12.0)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"strength","type":"codeVoice"},{"text":" — maximum pixel displacement (typical range 1.5–5.0)","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(.init(zoneWidth: 12, strength: 2))]))"]},{"type":"heading","anchor":"Chromatic-aberration","text":"Chromatic aberration","level":3},{"type":"paragraph","inlineContent":[{"text":"Separates RGB channels near the indicator edge, creating a color fringe effect.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"zoneWidth","type":"codeVoice"},{"text":" — width of the aberration zone in points (typical range 1.0–6.0)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"strength","type":"codeVoice"},{"text":" — RGB channel separation in pixels (typical range 1.0–4.0)","type":"text"}]}]}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(effects: [.chromaticAberration(.init(zoneWidth: 8, strength: 4))]))"]},{"type":"paragraph","inlineContent":[{"text":"Both effects can be combined:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(), .chromaticAberration()]))"]},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"Both effects are inspired by their physical counterparts and do not attempt to model them accurately.","type":"text"}],"type":"paragraph"}],"name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All Selection indicator configuration options are available interactively in the Example App under the "},{"type":"strong","inlineContent":[{"type":"text","text":"Selection indicator"}]},{"type":"text","text":" settings section."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/barkit\/configuringselectionindicator"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/barkit.BarKit\/documentation\/BarKit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/barkit.BarKit\/documentation\/BarKit\/GettingStarted","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringLayout","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringBackground","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringItems","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringAnimations","doc:\/\/barkit.BarKit\/documentation\/BarKit\/TabBarIntegration","doc:\/\/barkit.BarKit\