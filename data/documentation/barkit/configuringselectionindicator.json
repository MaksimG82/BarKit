{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/barkit\/configuringselectionindicator"]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/barkit.BarKit\/documentation\/BarKit\/GettingStarted","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringLayout","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringBackground","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringItems","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringAnimations","doc:\/\/barkit.BarKit\/documentation\/BarKit\/TabBarIntegration","doc:\/\/barkit.BarKit\/documentation\/BarKit\/AdditionalConfiguration"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The selection indicator is a rounded rectangle that moves between items when selection changes."},{"type":"text","text":" "},{"type":"text","text":"It is configured via "},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/SelectionIndicatorConfiguration","type":"reference","isActive":true},{"type":"text","text":", passed to "},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarConfiguration\/indicator","type":"reference","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to disable the indicator entirely."}]},{"anchor":"Color-and-border","type":"heading","level":2,"text":"Color and border"},{"type":"codeListing","code":[".init(","    indicator: .init(","        color: .white.opacity(0.2),","        border: .init(color: .white.opacity(0.4), lineWidth: 1)","    )",")"],"syntax":"swift"},{"anchor":"Insets","type":"heading","level":2,"text":"Insets"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Control the gap between the indicator and the item frame:"}]},{"type":"codeListing","code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Positive values shrink the indicator, negative values expand it beyond the item bounds.","type":"text"}]},{"anchor":"Transition-animation","type":"heading","level":2,"text":"Transition animation"},{"type":"paragraph","inlineContent":[{"text":"The indicator moves between items with a configurable animation:","type":"text"}]},{"type":"codeListing","code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"],"syntax":"swift"},{"anchor":"Scale-effect","type":"heading","level":2,"text":"Scale effect"},{"inlineContent":[{"type":"text","text":"Apply a brief scale pulse to the indicator during transition:"}],"type":"paragraph"},{"syntax":"swift","code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"],"type":"codeListing"},{"text":"Drag gesture","type":"heading","anchor":"Drag-gesture","level":2},{"inlineContent":[{"type":"text","text":"By default the user can drag the indicator between items. Disable if needed:"}],"type":"paragraph"},{"syntax":"swift","code":[".init(indicator: .init(isDragGestureEnabled: false))"],"type":"codeListing"},{"text":"Metal shader effects","type":"heading","anchor":"Metal-shader-effects","level":2},{"inlineContent":[{"type":"text","text":"Visual effects applied at the indicator boundary, inspired by lens distortion and chromatic aberration."}],"type":"paragraph"},{"text":"Lens distortion","type":"heading","anchor":"Lens-distortion","level":3},{"inlineContent":[{"text":"Displaces pixels near the indicator edge, creating a subtle warping effect.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"zoneWidth","type":"codeVoice"},{"text":" — width of the distortion zone in points (typical range 2.0–12.0)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"strength"},{"type":"text","text":" — maximum pixel displacement (typical range 1.5–5.0)"}]}]}]},{"syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(.init(zoneWidth: 12, strength: 2))]))"],"type":"codeListing"},{"level":3,"text":"Chromatic aberration","type":"heading","anchor":"Chromatic-aberration"},{"inlineContent":[{"type":"text","text":"Separates RGB channels near the indicator edge, creating a color fringe effect."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"zoneWidth","type":"codeVoice"},{"text":" — width of the aberration zone in points (typical range 1.0–6.0)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"strength","type":"codeVoice"},{"text":" — RGB channel separation in pixels (typical range 1.0–4.0)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","code":[".init(indicator: .init(effects: [.chromaticAberration(.init(zoneWidth: 8, strength: 4))]))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both effects can be combined:"}],"type":"paragraph"},{"syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(), .chromaticAberration()]))"],"type":"codeListing"},{"style":"note","content":[{"inlineContent":[{"text":"Both effects are inspired by their physical counterparts and do not attempt to model them accurately.","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside"},{"inlineContent":[{"type":"text","text":"All Selection indicator configuration options are available interactively in the Example App under the "},{"type":"strong","inlineContent":[{"type":"text","text":"Selection indicator"}]},{"type":"text","text":" settings section."}],"type":"paragraph"}]}],"identifier":{"url":"