t":"Control the appearance of individual bar items."}],"title":"Configuring Items","role":"article","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringItems","url":"\/documentation\/barkit\/configuringitems","kind":"article","type":"topic"},"doc://barkit.BarKit/documentation/BarKit/ConfiguringBadges":{"kind":"article","title":"Configuring Badges","role":"article","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringBadges","abstract":[{"text":"Display badge overlays on bar items to communicate status or counts.","type":"text"}],"url":"\/documentation\/barkit\/configuringbadges","type":"topic"},"doc://barkit.BarKit/documentation/BarKit/TabBarIntegration":{"title":"Tab Bar Integration","kind":"article","abstract":[{"type":"text","text":"Use BarKit as a floating or pinned tab bar."}],"type":"topic","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/TabBarIntegration","role":"article","url":"\/documentation\/barkit\/tabbarintegration"}}}