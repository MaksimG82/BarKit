to disable the indicator entirely."}],"type":"paragraph"},{"text":"Color and border","anchor":"Color-and-border","level":2,"type":"heading"},{"syntax":"swift","code":[".init(","    indicator: .init(","        color: .white.opacity(0.2),","        border: .init(color: .white.opacity(0.4), lineWidth: 1)","    )",")"],"type":"codeListing"},{"text":"Insets","anchor":"Insets","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Control the gap between the indicator and the item frame:"}],"type":"paragraph"},{"syntax":"swift","code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"],"type":"codeListing"},{"inlineContent":[{"text":"Positive values shrink the indicator, negative values expand it beyond the item bounds.","type":"text"}],"type":"paragraph"},{"text":"Transition animation","anchor":"Transition-animation","level":2,"type":"heading"},{"inlineContent":[{"text":"The indicator moves between items with a configurable animation:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"],"type":"codeListing"},{"level":2,"type":"heading","text":"Scale effect","anchor":"Scale-effect"},{"type":"paragraph","inlineContent":[{"text":"Apply a brief scale pulse to the indicator during transition:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"]},{"level":2,"type":"heading","text":"Drag gesture","anchor":"Drag-gesture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default the user can drag the indicator between items. Disable if needed:"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(is