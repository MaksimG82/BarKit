,"text":"Control the gap between the indicator and the item frame:"}],"type":"paragraph"},{"code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Positive values shrink the indicator, negative values expand it beyond the item bounds.","type":"text"}],"type":"paragraph"},{"anchor":"Transition-animation","level":2,"text":"Transition animation","type":"heading"},{"inlineContent":[{"type":"text","text":"The indicator moves between items with a configurable animation:"}],"type":"paragraph"},{"code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"],"type":"codeListing","syntax":"swift"},{"anchor":"Scale-effect","level":2,"text":"Scale effect","type":"heading"},{"inlineContent":[{"text":"Apply a brief scale pulse to the indicator during transition:","type":"text"}],"type":"paragraph"},{"code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"],"type":"codeListing","syntax":"swift"},{"anchor":"Drag-gesture","level":2,"text":"Drag gesture","type":"heading"},{"inlineContent":[{"type":"text","text":"By default the user can drag the indicator between items. Disable if needed:"}],"type":"paragraph"},{"code":[".init(indicator: .init(isDragGestureEnabled: false))"],"type":"codeListing","syntax":"swift"},{"anchor":"Metal-shader-effects","level":2,"text":"Metal shader effects","type":"heading"},{"inlineContent":[{"text":"Visual effects applied at the indicator boundary, inspired by lens distortion and chromatic aberration.","type":"text"}],"type":"paragraph"},{"anchor":"Lens-distortion","level":3,"text":"Lens distortion","type":"heading"},{"inlineContent":[{"text":"Displaces pixels near the indicator edge, creating a subtle warping effect.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"text":" — width of the distortion zone in points (typical range 2.0–12.0)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"strength","type":"codeVoice"},{"type":"text","text":" — maximum pixel displacement (typical range 1.5–5.0)"}]}]}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(.init(zoneWidth: 12, strength: 2))]))"]},{"type":"heading","level":3,"anchor":"Chromatic-aberration","text":"Chromatic aberration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Separates RGB channels near the indicator edge, creating a color fringe effect."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"zoneWidth","type":"codeVoice"},{"text":" — width of the aberration zone in points (typical range 1.0–6.0)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"strength","type":"codeVoice"},{"type":"text","text":" — RGB channel separation in pixels (typical range 1.0–4.0)"}]}]}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(effects: [.chromaticAberration(.init(zoneWidth: 8, strength: 4))]))"]},{"type":"paragraph","inlineContent":[{"text":"Both effects can be combined:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(), .chromaticAberration()]))"]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Both effects are inspired by their physical counterparts and do not attempt to model them accurately."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All Selection indicator configuration options are available interactively in the Example App under the "},{"type":"strong","inlineContent":[{"type":"text","text":"Selection indicator"}]},{"type":"text","text":" settings section."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/barkit\/configuringselectionindicator"]}],"metadata":{"title":"Configuring the Selection Indicator","role":"article","modules":[{"name":"BarKit"}],"roleHeading":"Article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Customize the animated highlight that tracks the selected item."}],"sections":[],"references":{"doc://barkit.BarKit/documentation/BarKit/TabBarIntegration":{"url":"\/documentation\/barkit\/tabbarintegration","role":"article","abstract":[{"text":"Use BarKit as a floating or pinned tab bar.","type":"text"}],"title":"Tab Bar Integration","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/TabBarIntegration","kind":"article","type":"topic"},"doc://barkit.BarKit/documentation/BarKit/ConfiguringBadges":{"type":"topic","abstract":[{"type":"text","text":"Display badge overlays on bar items to communicate status or counts."}],"role":"article","title":"Configuring Badges","url":"\/documentation\/barkit\/configuringbadges","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringBadges","kind":"article"},"doc://barkit.BarKit/documentation/BarKit/ConfiguringLayout":{"role":"article","title":"Configuring the Layout","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringLayout","url":"\/documentation\/barkit\/configuringlayout","type":"topic","abstract":[{"type":"text","text":"Control the bar’s size, axis, and item arrangement."}],"kind":"article"},"doc://barkit.BarKit/documentation/BarKit/ConfiguringBackground":{"role":"article","type":"topic","title":"Configuring the Background","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringBackground","abstract":[{"type":"text","text":"Control the bar’s background appearance."}],"kind":"article","url":"\/documentat