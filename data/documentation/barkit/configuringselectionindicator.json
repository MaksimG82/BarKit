{"hierarchy":{"paths":[["doc:\/\/barkit.BarKit\/documentation\/BarKit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/barkit.BarKit\/documentation\/BarKit\/GettingStarted","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringLayout","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringBackground","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringItems","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringAnimations","doc:\/\/barkit.BarKit\/documentation\/BarKit\/TabBarIntegration","doc:\/\/barkit.BarKit\/documentation\/BarKit\/AdditionalConfiguration"],"generated":true}],"identifier":{"url":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringSelectionIndicator","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","abstract":[{"type":"text","text":"Customize the animated highlight that tracks the selected item."}],"variants":[{"paths":["\/documentation\/barkit\/configuringselectionindicator"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","modules":[{"name":"BarKit"}],"roleHeading":"Article","title":"Configuring the Selection Indicator"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The selection indicator is a rounded rectangle that moves between items when selection changes."},{"type":"text","text":" "},{"type":"text","text":"It is configured via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/SelectionIndicatorConfiguration"},{"type":"text","text":", passed to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarConfiguration\/indicator"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to disable the indicator entirely."}]},{"level":2,"text":"Color and border","type":"heading","anchor":"Color-and-border"},{"syntax":"swift","type":"codeListing","code":[".init(","    indicator: .init(","        color: .white.opacity(0.2),","        border: .init(color: .white.opacity(0.4), lineWidth: 1)","    )",")"]},{"level":2,"text":"Insets","type":"heading","anchor":"Insets"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Control the gap between the indicator and the item frame:"}]},{"syntax":"swift","type":"codeListing","code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Positive values shrink the indicator, negative values expand it beyond the item bounds."}]},{"level":2,"text":"Transition animation","type":"heading","anchor":"Transition-animation"},{"type":"paragraph","inlineContent":[{"text":"The indicator moves between items with a configurable animation:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"]},{"level":2,"anchor":"Scale-effect","type":"heading","text":"Scale effect"},{"inlineContent":[{"text":"Apply a brief scale pulse to the indicator during transition:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"]},{"level":2,"anchor":"Drag-gesture","type":"heading","text":"Drag gesture"},{"inlineContent":[{"text":"By default the user can drag the indicator between items. Disable if needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".init(indicator: .init(isDragGestureEnabled: false))"]},{"level":2,"anchor":"Metal-shader-effects","type":"heading","text":"Metal shader effects"},{"inlineContent":[{"type":"text","text":"Visual effects applied at the indicator boundary, inspired by lens distortion and chromatic aberration."}],"type":"paragraph"},{"level":3,"anchor":"Lens-distortion","type":"heading","text":"Lens distortion"},{"inlineContent":[{"type":"text","text":"Displaces pixels near the indicator edge, creating a subtle warping effect."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"type":"text","text":" — width of the distortion zone in points (typical range 2.0–12.0)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"strength"},{"type":"text","text":" — maximum pixel displacement (typical range 1.5–5.0)"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(.init(zoneWidth: 12, strength: 2))]))"],"type":"codeListing"},{"level":3,"anchor":"Chromatic-aberration","type":"heading","text":"Chromatic aberration"},{"inlineContent":[{"type":"text","text":"Separates RGB channels near the indicator edge, creating a color fringe effect."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"zoneWidth","type":"codeVoice"},{"text":" — width of the aberration zone in points (typical range 1.0–6.0)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"strength","type":"codeVoice"},{"text":" — RGB channel separation in pixels (typical range 1.0–4.0)","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":[".init(indicator: .init(effects: [.chromaticAberration(.init(zoneWidth: 8, strength: 4))]))"],"type":"codeListing"},{"inlineContent":[{"text":"Both effects can be combined:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".init(indicator: .init(effects: [.lensDistortion(), .chromaticAberration()]))"],"type":"codeListing"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Both effects are inspired by their physical counterparts and do not attempt to model them accurately."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"inlineContent":[{"type":"text","text":"All Selection indicator configuration options are available interactively in the Example App under the "},{"type":"strong","inlineContent":[{"text":"Selection indicator","type":"text"}]},{"type":"text","text":" settings section."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"references":{"doc://barkit.BarKit/documentation/BarKit/GettingStarted":{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/GettingStarted","kind":"article","role":"article","abstract":[{"type":"text","text":"Add a customizable bar to your SwiftUI app in minutes."}],"type":"topic","title":"Getting Started","url":"\/documentation\/barkit\/gettingstarted"},"doc://barkit.BarKit/documentation/BarKit/BarConfiguration/indicator":{"abstract":[{"text":"Appearance and behavior configuration for the selection indicator.","type":"text"}],"title":"indicator","kind":"symbol","url":"\/documentation\/barkit\/barconfiguration\/indicator","role":"symbol","type":"topic","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarConfiguration\/indicator","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"indicator","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SelectionIndicatorConfiguration","kind":"typeIdentifier","preciseIdentifier":"s:6BarKit31SelectionIndicatorConfigurationV"},{"text":"?","kind":"text"}]},"doc://barkit.BarKit/documentation/BarKit/ConfiguringLayout":{"kind":"article","type":"topic","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringLayout","abstract":[{"type":"text","text":"Control the bar’s size, axis, and item arrangement."}],"title":"Configuring the Layout","url":"\/documentation\/barkit\/configuringlayout","role":"article"},"doc://barkit.BarKit/documentation/BarKit/TabBarIntegration":{"abstract":[{"type":"