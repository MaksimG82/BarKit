{"abstract":[{"type":"text","text":"Customize the animated highlight that tracks the selected item."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/barkit\/configuringselectionindicator"]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"BarKit"}],"title":"Configuring the Selection Indicator"},"hierarchy":{"paths":[["doc:\/\/barkit.BarKit\/documentation\/BarKit"]]},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringSelectionIndicator","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The selection indicator is a rounded rectangle that moves between items when selection changes.","type":"text"},{"text":" ","type":"text"},{"text":"It is configured via ","type":"text"},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/SelectionIndicatorConfiguration","isActive":true,"type":"reference"},{"text":", passed to ","type":"text"},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarConfiguration\/indicator","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Pass ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to disable the indicator entirely.","type":"text"}]},{"anchor":"Color-and-border","level":2,"type":"heading","text":"Color and border"},{"syntax":"swift","code":[".init(","    indicator: .init(","        color: .white.opacity(0.2),","        border: .init(color: .white.opacity(0.4), lineWidth: 1)","    )",")"],"type":"codeListing"},{"anchor":"Insets","level":2,"type":"heading","text":"Insets"},{"type":"paragraph","inlineContent":[{"text":"Control the gap between the indicator and the item frame:","type":"text"}]},{"syntax":"swift","code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Positive values shrink the indicator, negative values expand it beyond the item bounds."}]},{"anchor":"Transition-animation","level":2,"type":"heading","text":"Transition animation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The indicator moves between items with a configurable animation:"}]},{"syntax":"swift","code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"],"type":"codeListing"},{"type":"heading","level":2,"text":"Scale effect","anchor":"Scale-effect"},{"inlineContent":[{"type":"text","text":"Apply a brief scale pulse to the indicator during transition:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"]},{"type":"heading","level":2,"text":"Drag gesture","anchor":"Drag-gesture"},{"inlineContent":[{"text":"By default the user can drag the indicator between items. Disable if needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".init(indicator: .init(isDragGestureEnabled: false))"]},{"type":"heading","level":2,"text":"Metal shader effects","anchor":"Metal-shader-effects"},{"inlineContent":[{"text":"Visual effects applied at the indicator boundary, inspired by lens distortion and chromatic aberration.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Lens distortion","anchor":"Lens-distortion"},{"inlineContent":[{"type":"text","text":"Displaces pixels near the indicator edge, creating a subtle warping effect."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"type":"text","text":" — width of the distortion zone in points (typical range 2.0–12.0)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"strength"},{"type":"text","text":" — maximum pixel displacement (typical range 1.5–5.0)"}]}]}]},{"syntax":"swift","type":"codeListing","code":[".init(indicator: .init(effects: [.lensDistortion(.init(zoneWidth: 12, strength: 2))]))"]},{"type":"heading","level":3,"text":"Chromatic aberration","anchor":"Chromatic-aberration"},{"inlineContent":[{"type":"text","text":"Separates RGB channels near the indicator edge, creating a color fringe effect."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"type":"text","text":" — width of the aberration zone in points (typical range 1.0–6.0)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"strength"},{"text":" — RGB channel separation in pixels (typical range 1.0–4.0)","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":[".init(indicator: .init(effects: [.chromaticAberration(.init(zoneWidth: 8, strength: 4))]))"]},{"inlineContent":[{"text":"Both effects can be combined:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".init(indicator: .init(effects: [.lensDistortion(), .chromaticAberration()]))"]},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Both effects are inspired by their physical counterparts and do not attempt to model them accurately.","type":"text"}]}]},{"inlineContent":[{"text":"All Selection indicator configuration options are available interactively in the Example App under the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Selection indicator"}]},{"text":" settings section.","type":"text"}],"type":"paragraph"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/barkit.Bar