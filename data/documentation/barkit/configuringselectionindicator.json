{"abstract":[{"type":"text","text":"Customize the animated highlight that tracks the selected item."}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The selection indicator is a rounded rectangle that moves between items when selection changes."},{"type":"text","text":" "},{"type":"text","text":"It is configured via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/SelectionIndicatorConfiguration"},{"type":"text","text":", passed to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarConfiguration\/indicator"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Pass "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to disable the indicator entirely."}]},{"level":2,"type":"heading","text":"Color and border","anchor":"Color-and-border"},{"type":"codeListing","code":[".init(","    indicator: .init(","        color: .white.opacity(0.2),","        border: .init(color: .white.opacity(0.4), lineWidth: 1)","    )",")"],"syntax":"swift"},{"level":2,"type":"heading","text":"Insets","anchor":"Insets"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Control the gap between the indicator and the item frame:"}]},{"type":"codeListing","code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Positive values shrink the indicator, negative values expand it beyond the item bounds.","type":"text"}]},{"level":2,"type":"heading","text":"Transition animation","anchor":"Transition-animation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The indicator moves between items with a configurable animation:"}]},{"type":"codeListing","code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"],"syntax":"swift"},{"level":2,"type":"heading","text":"Scale effect","anchor":"Scale-effect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply a brief scale pulse to the indicator during transition:"}]},{"type":"codeListing","code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"],"syntax":"swift"},{"level":2,"type":"heading","text":"Drag gesture","anchor":"Drag-gesture"},{"type":"paragraph","inlineContent":[{"text":"By default the user can drag the indicator between items. Disable if needed:","type":"text"}]},{"type":"codeListing","code":[".init(indicator: .init(isDragGestureEnabled: false))"],"syntax":"swift"},{"level":2,"type":"heading","text":"Metal shader effects","anchor":"Metal-shader-effects"},{"type":"paragraph","inlineContent":[{"text":"Visual effects applied at the indicator boundary, inspired by lens distortion and chromatic aberration.","type":"text"}]},{"level":3,"type":"heading","text":"Lens distortion","anchor":"Lens-distortion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Displaces pixels near the indicator edge, creating a subtle warping effect."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"zoneWidth","type":"codeVoice"},{"text":" — width of the distortion zone in points (typical range 2.0–12.0)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"strength","type":"codeVoice"},{"text":" — maximum pixel displacement (typical range 1.5–5.0)","type":"text"}]}]}]},{"type":"codeListing","code":[".init(indicator: .init(effects: [.lensDistortion(.init(zoneWidth: 12, strength: 2))]))"],"syntax":"swift"},{"level":3,"type":"heading","text":"Chromatic aberration","anchor":"Chromatic-aberration"},{"type":"paragraph","inlineContent":[{"text":"Separates RGB channels near the indicator edge, creating a color fringe effect.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"type":"text","text":" — width of the aberration zone in points (typical range 1.0–6.0)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"strength"},{"type":"text","text":" — RGB channel separation in pixels (typical range 1.0–4.0)"}]}]}]},{"type":"codeListing","code":[".init(indicator: .init(effects: [.chromaticAberration(.init(zoneWidth: 8, strength: 4))]))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both effects can be combined:"}]},{"type":"codeListing","code":[".init(indicator: .init(effects: [.lensDistortion(), .chromaticAberration()]))"],"syntax":"swift"},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Both effects are inspired by their physical counterparts and do not attempt to model them accurately.","type":"text"}]}],"style":"note"},{"type":"paragraph","inlineContent":[{"text":"All Selection indicator configuration options are available interactively in the Example App under the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Selection indicator"}]},{"text":" settings section.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/barkit.BarKit\/documentation\/BarKit"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/barkit.BarKit\/documentation\/BarKit\/GettingStarted","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringLayout","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringBackground","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringItems","doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringAnimations","doc:\/\/barkit.BarKit\/documentation\/BarKit\/TabBarIntegration","doc:\/\/barkit.BarKit\/docume