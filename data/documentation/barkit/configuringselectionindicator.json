{"metadata":{"modules":[{"name":"BarKit"}],"role":"article","roleHeading":"Article","title":"Configuring the Selection Indicator"},"kind":"article","hierarchy":{"paths":[["doc:\/\/barkit.BarKit\/documentation\/BarKit"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The selection indicator is a rounded rectangle that moves between items when selection changes.","type":"text"},{"text":" ","type":"text"},{"text":"It is configured via ","type":"text"},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/SelectionIndicatorConfiguration","type":"reference","isActive":true},{"text":", passed to ","type":"text"},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarConfiguration\/indicator","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Pass ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" to disable the indicator entirely.","type":"text"}]},{"type":"heading","level":2,"text":"Color and border","anchor":"Color-and-border"},{"type":"codeListing","code":[".init(","    indicator: .init(","        color: .white.opacity(0.2),","        border: .init(color: .white.opacity(0.4), lineWidth: 1)","    )",")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Insets","anchor":"Insets"},{"type":"paragraph","inlineContent":[{"text":"Control the gap between the indicator and the item frame:","type":"text"}]},{"type":"codeListing","code":[".init(indicator: .init(inset: .init(top: 4, leading: 4, bottom: 4, trailing: 4)))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Positive values shrink the indicator, negative values expand it beyond the item bounds."}]},{"type":"heading","level":2,"text":"Transition animation","anchor":"Transition-animation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The indicator moves between items with a configurable animation:"}]},{"type":"codeListing","code":["\/\/ Spring (default)",".init(indicator: .init(transitionAnimation: .parameters(.init(type: .spring, duration: 0.4))))","","\/\/ Custom SwiftUI animation",".init(indicator: .init(transitionAnimation: .custom(.bouncy)))","","\/\/ Instant snap",".init(indicator: .init(transitionAnimation: nil))"],"syntax":"swift"},{"type":"heading","level":2,"text":"Scale effect","anchor":"Scale-effect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply a brief scale pulse to the indicator during transition:"}]},{"type":"codeListing","code":[".init(indicator: .init(scaleEffect: .init(xScale: 1.3, yScale: 1.1, duration: 0.2)))"],"syntax":"swift"},{"type":"heading","level":2,"text":"Drag gesture","anchor":"Drag-gesture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default the user can drag the indicator between items. Disable if needed:"}]},{"type":"codeListing","code":[".init(indicator: .init(isDragGestureEnabled: false))"],"syntax":"swift"},{"type":"heading","level":2,"text":"Metal shader effects","anchor":"Metal-shader-effects"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Visual effects applied at the indicator boundary, inspired by lens distortion and chromatic aberration."}]},{"type":"heading","level":3,"text":"Lens distortion","anchor":"Lens-distortion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Displaces pixels near the indicator edge, creating a subtle warping effect."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"type":"text","text":" — width of the distortion zone in points (typical range 2.0–12.0)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"strength"},{"type":"text","text":" — maximum pixel displacement (typical range 1.5–5.0)"}]}]}]},{"type":"codeListing","code":[".init(indicator: .init(effects: [.lensDistortion(.init(zoneWidth: 12, strength: 2))]))"],"syntax":"swift"},{"type":"heading","level":3,"text":"Chromatic aberration","anchor":"Chromatic-aberration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Separates RGB channels near the indicator edge, creating a color fringe effect."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"zoneWidth"},{"type":"text","text":" — width of the aberration zone in points (typical range 1.0–6.0)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"strength","type":"codeVoice"},{"text":" — RGB channel separation in pixels (typical range 1.0–4.0)","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","code":[".init(indicator: .init(effects: [.chromaticAberration(.init(zoneWidth: 8, strength: 4))]))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Both effects can be combined:","type":"text"}]},{"type":"codeListing","code":[".init(indicator: .init(effects: [.lensDistortion(), .chromaticAberration()]))"],"syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Both effects are inspired by their physical counterparts and do not attempt to model them accurately.","type":"text"}]}],"style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All Selection indicator configuration options are available interactively in the Example App under the "},{"type":"strong","inlineContent":[{"type":"text","text":"Selection indicator"}]},{"type":"text","text":" settings section."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/barkit\/configuringselectionindicator"]}],"abstract":[{"type":"text","text":"Customize the animated highlight that tracks the selected item."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/ConfiguringSelectionIndicator"},"seeAlsoSections":[{"generated":true,