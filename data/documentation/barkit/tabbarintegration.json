"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To prevent content from being obscured by the floating bar, add a bottom inset"},{"type":"text","text":" "},{"type":"text","text":"equal to the bar height. The Example App demonstrates this via "},{"type":"codeVoice","code":"floatingTabBarOffset(_:barID:)"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"safeAreaInset"},{"type":"text","text":" modifier that collapses automatically when the bar is hidden."}]},{"anchor":"Hiding-the-bar","type":"heading","level":2,"text":"Hiding the bar"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bar visibility is controlled through a shared environment value "},{"type":"codeVoice","code":"bkBarVisibility"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"a dictionary that maps bar identifiers to their "},{"type":"codeVoice","code":"Visibility"},{"type":"text","text":" state."}]},{"type":"paragraph","inlineContent":[{"text":"Inject the binding at the container level with ","type":"text"},{"code":"registerBarVisibility(_:)","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":["@State private var barVisibility: [String: Visibility] = [:]","","ZStack(alignment: .bottom) {","    ContentView()","    if barVisibility[\"tabBar\"] != .hidden {","        FloatingTabBarView(items: items, selected: $selected, id: \"tabBar\")","    }","}",".registerBarVisibility($barVisibility)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Any child view can then write ","type":"text"},{"code":".hidden","type":"codeVoice"},{"text":" into the environment via ","type":"text"},{"code":"hideBar(id:)","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["SomeDetailView()","    .hideBar(id: \"tabBar\")"]},{"inlineContent":[{"code":"hideBar(id:)","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":".hidden","type":"codeVoice"},{"text":" on appear and restores ","type":"text"},{"code":".visible","type":"codeVoice"},{"text":" on disappear automatically.","type":"text"},{"text":" ","type":"text"},{"text":"The rendering decision — whether to show or remove the bar — belongs to the container.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Prominent items","anchor":"Prominent-items"},{"inlineContent":[{"type":"codeVoice","code":"PinnedTabBarView"},{"type":"text","text":" supports a "},{"type":"codeVoice","code":".prominent"},{"type":"text","text":" item style for items that overflow"},{"type":"text","text":" "},{"type":"text","text":"beyond the bar bounds — useful for a raised center action button:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let items: [MyItem] = [","    MyItem(title: \"Home\",   icon: .system(\"house.fill\"),   style: .regular),","    MyItem(title: \"Camera\", icon: .system(\"camera.fill\"),  style: .prominent),","    MyItem(title: \"Profile\",icon: .system(\"person.fill\"),  style: .regular),","]","","PinnedTabBarView(","    items: items,","    selected: $selected,","    configuration: .init(","        itemStyles: [","            .regular:   .init(iconSideLength: 24),","            .prominent: .init(iconSideLength: 40),","        ],","        baselineStyle: .regular","    )",")"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The bar height is fixed to the "},{"type":"codeVoice","code":"baselineStyle"},{"type":"text","text":" metrics, allowing prominent items to overflow upward."}]}],"type":"aside","style":"note","name":"Note"},{"type":"heading","level":2,"text":"Example App","anchor":"Example-App"},{"inlineContent":[{"type":"text","text":"All tab bar features — floating and pinned layouts, insets, item styles, indicator,"},{"type":"text","text":" "},{"type":"text","text":"and hide behavior — are demonstrated interactively in the included Example App."}],"type":"paragraph"}]