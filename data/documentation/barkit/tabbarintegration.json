{"hierarchy":{"paths":[["doc:\/\/barkit.BarKit\/documentation\/BarKit"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/TabBarIntegration"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"BarKit provides two ready-to-use tab bar wrappers built on top of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarView","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/FloatingTabBarView"},{"type":"text","text":" — a detached capsule positioned above the content"}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/PinnedTabBarView","isActive":true},{"type":"text","text":" — a full-width bar pinned to the bottom edge"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Floating tab bar","type":"heading","anchor":"Floating-tab-bar"},{"inlineContent":[{"text":"Place ","type":"text"},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/FloatingTabBarView","isActive":true,"type":"reference"},{"text":" in a ","type":"text"},{"code":"ZStack","type":"codeVoice"},{"text":" above your content.","type":"text"},{"text":" ","type":"text"},{"text":"Safe area handling is the responsibility of the calling code:","type":"text"}],"type":"paragraph"},{"code":["ZStack(alignment: .bottom) {","    ContentView()","    FloatingTabBarView(items: items, selected: $selected)","}",".ignoresSafeArea(.all, edges: .bottom)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Position the capsule using "},{"type":"codeVoice","code":"floatingInsets"},{"type":"text","text":":"}],"type":"