ured by the floating bar, add a bottom inset","type":"text"},{"text":" ","type":"text"},{"text":"equal to the bar height. The Example App demonstrates this via ","type":"text"},{"code":"floatingTabBarOffset(_:barID:)","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"code":"safeAreaInset","type":"codeVoice"},{"text":" modifier that collapses automatically when the bar is hidden.","type":"text"}],"type":"paragraph"},{"text":"Hiding the bar","type":"heading","level":2,"anchor":"Hiding-the-bar"},{"inlineContent":[{"type":"text","text":"Bar visibility is controlled through a shared environment value "},{"type":"codeVoice","code":"bkBarVisibility"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"a dictionary that maps bar identifiers to their "},{"type":"codeVoice","code":"Visibility"},{"type":"text","text":" state."}],"type":"paragraph"},{"inlineContent":[{"text":"Inject the binding at the container level with ","type":"text"},{"type":"codeVoice","code":"registerBarVisibility(_:)"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@State private var barVisibility: [String: Visibility] = [:]","","ZStack(alignment: .bottom) {","    ContentView()","    if barVisibility[\"tabBar\"] != .hidden {","        FloatingTabBarView(items: items, selected: $selected, id: \"tabBar\")","    }","}",".registerBarVisibility($barVisibility)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Any child view can then write "},{"type":"codeVoice","code":".hidden"},{"type":"text","text":" into the environment via "},{"type":"codeVoice","code":"hideBar(id:)"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["SomeDetailView()","    .hideBar(id: \"tabBar\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"hideBar(id:)","type":"codeVoice"},{"text":" writes ","type":"text"},{"code":".hidden","type":"codeVoice"},{"text":" on appear and restores ","type":"text"},{"code":".visible","type":"codeVoice"},{"text":" on disappear automatically.","type":"text"},{"text":" ","type":"text"},{"text":"The rendering decision — whether to show or remove the bar — belongs to the container.","type":"text"}],"type":"paragraph"},{"anchor":"Prominent-items","type":"heading","text":"Prominent items","level":2},{"inlineContent":[{"type":"codeVoice","code":"PinnedTabBarView"},{"type":"text","text":" supports a "},{"type":"codeVoice","code":".prominent"},{"type":"text","text":" item style for items that overflow"},{"type":"text","text":" "},{"type":"text","text":"beyond the bar bounds — useful for a raised center action button:"}],"type":"paragraph"},{"code":["let items: [MyItem] = [","    MyItem(title: \"Home\",   icon: .system(\"house.fill\"),   style: .regular),","    MyItem(title: \"Camera\", icon: .system(\"camera.fill\"),  style: .prominent),","    MyItem(title: \"Profile\",icon: .system(\"person.fill\"),  style: .regular),","]","","PinnedTabBarView(","    items: items,","    selected: $selected,","    configuration: .init(","        itemStyles: [","            .regular:   .init(iconSideLength: 24),","            .prominent: .init(iconSideLength: 40),","        ],","        baselineStyle: .regular","    )",")"],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"text":"The bar height is fixed to the ","type":"text"},{"code":"baselineStyle","type":"codeVoice"},{"text":" metrics, allowing prominent items to overflow upward.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"anchor":"Example-App","type":"heading","text":"Example App","level":2},{"inlineContent":[{"type":"text","text":"All tab bar features — floating and pinned layouts, insets, item styles, indicator,"},{"type":"text","text":" "},{"type":"text","text":"and hide behavior — are demonstrated interactively in the included Example App."}],"type":"paragraph"}]}],"sections":[],"metadata":{"title":"Tab Bar Integration","modu