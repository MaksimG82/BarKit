{"abstract":[{"type":"text","text":"Add a customizable bar to your SwiftUI app in minutes."}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"BarKit is built around "},{"identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarView","type":"reference","isActive":true},{"type":"text","text":" — a flexible bar that renders selectable items"},{"type":"text","text":" "},{"type":"text","text":"with a fully customizable appearance. Use it standalone or as a tab bar."}],"type":"paragraph"},{"level":2,"text":"Define your items","anchor":"Define-your-items","type":"heading"},{"inlineContent":[{"type":"text","text":"Conform to "},{"type":"reference","identifier":"doc:\/\/barkit.BarKit\/documentation\/BarKit\/BarItemProtocol","isActive":true},{"type":"text","text":" to describe your items:"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyItem: BarItemProtocol {","    let title: String","    let icon: BarIcon","    var style: BarItemStyle = .regular","    var id: AnyHashable { title }","}"],"type":"codeListing"},{"level":2,"text":"Standalone BarView","anchor":"Standalone-BarView","type":"heading"},{"syntax":"swift","code":["@State private var selected = items[0]","","let items: [MyItem] = [","    MyItem(title: \"Wine\",     icon: .system(\"wineglass.fill\")),","    MyItem(title: \"Beer\",     icon: .system(\"mug.fill\")),","    MyItem(title: \"Tea\",      icon: .system(\"cup.and.saucer.fill\")),","    MyItem(title: \"Cocktail\", icon: .system(\"bubbles.and.sparkles\")),","]","","BarView(items: items, selected: $selected)"],"type":"codeListing"},{"level":2,"text":"Floating tab bar","anchor":"Floating-tab-bar","type":"heading"},{"syntax":"swift","code":["ZStack(alignment: .bottom) {","    ContentView()","    FloatingTabBarView(items: items, selected: $selected)","}",".ignoresSafeArea(.all, edges: .bottom)"],"type":"codeListing"},{"level":2,"text":"Pinned tab bar","anch